            "id": 3,
            "module": "google-sheets:addRow",
            "version": 2,
            "parameters": {
                "__IMTCONN__": 10470978
            },
            "filter": {
                "name": "Suspicious Email Check",
                "conditions": [
                    [
                        {
                            "a": "{{2.subject}}",
                            "o": "text:contain:ci",
                            "b": "verify your account"
                        }
                    ],
                    [
                        {
                            "a": "{{2.subject}}",
                            "o": "text:contain:ci",
                            "b": "urgent action required"
                        }
                    ],
                    [
                        {
                            "a": "{{2.subject}}",
                            "o": "text:contain:ci",
                            "b": "account suspended"
                        }
                    ],
                    [
                        {
                            "a": "{{2.subject}}",
                            "o": "text:contain:ci",
                            "b": "confirm your identity"
                        }
                    ],
                    [
                        {
                            "a": "{{2.subject}}",
                            "o": "text:contain:ci",
                            "b": "password expired"
                        }
                    ],
                    [
                        {
                            "a": "{{2.fullTextBody}}",
                            "o": "text:contain:ci",
                            "b": "click here to confirm"
                        }
                    ],
                    [
                        {
                            "a": "{{2.fullTextBody}}",
                            "o": "text:contain:ci",
                            "b": "update your payment"
                        }
                    ],
                    [
                        {
                            "a": "{{2.fromEmail}}",
                            "o": "text:contain:ci",
                            "b": "noreply"
                        }
                    ]
                ]
            },
            "mapper": {
                "mode": "select",
                "insertUnformatted": false,
                "valueInputOption": "USER_ENTERED",
                "insertDataOption": "INSERT_ROWS",
                "from": "drive",
