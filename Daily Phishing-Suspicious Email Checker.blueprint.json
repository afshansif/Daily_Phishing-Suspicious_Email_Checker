                "sheetId": "Sheet1",
                "includesHeaders": true,
                "useColumnHeaders": true,
                "values": {
                    "Date Received": "{{2.internalDate}}",
                    "Sender Email": "{{2.fromEmail}}",
                    "Subject": "{{2.subject}}",
                    "Snippet": "{{2.snippet}}",
                    "Matched Keyword": "/{{if(contains(2.subject; \"verify your account\"); \"verify your account\"; if(contains(2.subject; \"urgent action required\"); \"urgent action required\"; if(contains(2.subject; \"account suspended\"); \"account suspended\"; if(contains(2.subject; \"confirm your identity\"); \"confirm your identity\"; if(contains(2.subject; \"password expired\"); \"password expired\"; if(contains(2.fullTextBody; \"click here to confirm\"); \"click here to confirm\"; if(contains(2.fullTextBody; \"update your payment\"); \"update your payment\"; if(contains(2.fromEmail; \"noreply\"); \"noreply sender\"; \"unknown\"))))))))}}\n",
